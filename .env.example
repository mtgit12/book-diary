# Docker Compose 用の環境変数(開発環境)
# cp .env.example .env でコピーして使う。値は backend/.env の DB_* と合わせる。
DB_DATABASE=book_diary
DB_USERNAME=book_diary
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-root

# ホストに公開する MySQL のポート(GUI クライアントなどから接続する場合)
DB_FORWARD_PORT=3306

# Linux でファイルの所有者を合わせる場合に指定する(macOS では不要)
# UID=1000
# GID=1000
